SPRING_PROFILES_ACTIVE=local # 로컬 개발 기본 profile. 원격 서버에서는 prod 또는 dev로 변경
SERVER_PORT=8080 # Spring Boot가 뜨는 포트
HOST_PORT=8080 # Docker Compose로 앱 컨테이너까지 띄울 때 노트북에 노출할 포트

DB_DDL_AUTO=create # create=초기화, update=보존, validate=검증
DB_DEFER_DATASOURCE_INITIALIZATION=true # 테이블 생성 후 seed 실행
DB_NAME=sopkathon # Docker Compose MySQL이 만들 DB 이름
DB_URL=jdbc:mysql://localhost:13306/sopkathon?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8 # 로컬 JVM에서 Docker MySQL로 접속하는 JDBC URL
DB_USERNAME=sopt # 로컬 MySQL 계정
DB_PASSWORD=sopt # 로컬 MySQL 비밀번호
MYSQL_ROOT_PASSWORD=root # 로컬 Docker MySQL root 비밀번호
MYSQL_PORT=13306 # 내 노트북에 노출되는 MySQL 포트. 3306 충돌을 피하려고 13306 사용
DB_SQL_INIT_MODE=always # always=seed 실행, never=끄기
DB_SQL_INIT_DATA_LOCATIONS=optional:classpath:db/seed/local-test-account.sql # seed SQL 위치

APP_SECURITY_PERMIT_ALL=true # MVP 초반은 true, JWT 인증 연동 시작 후 false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173 # 웹 로컬 origin. 배포 웹 주소가 생기면 쉼표로 추가
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS # 브라우저에서 허용할 HTTP method
APP_CORS_ALLOWED_HEADERS=* # 브라우저 요청에서 허용할 header
APP_CORS_EXPOSED_HEADERS=Authorization,Location # 브라우저 JS에서 읽을 수 있게 노출할 응답 header
APP_CORS_ALLOW_CREDENTIALS=true # 쿠키/인증 header 포함 요청을 허용할지 여부. true면 origin은 * 사용 금지

APP_JWT_ISSUER=sopkathon # JWT 발급자 이름
APP_JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-bytes # JWT 서명 secret. 실제 서버에서는 긴 랜덤 값으로 교체
APP_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=2880 # 해커톤 시연용 access token 만료 시간. 2880분=48시간, refresh token은 사용하지 않음

APP_SWAGGER_SERVER_URL=http://localhost:8080 # Swagger Try it out이 호출할 API 서버 URL
APP_SWAGGER_SERVER_DESCRIPTION=로컬 테스트 Swagger 입니다! # Swagger server 설명
