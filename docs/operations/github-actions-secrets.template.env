# GitHub 저장소 Secrets 템플릿
# 위치: GitHub Repository -> Settings -> Secrets and variables -> Actions -> Secrets
# 아래 값은 로그나 코드에 노출되면 안 된다.

# Docker Hub 액세스 토큰. 계정 비밀번호 대신 토큰을 쓴다.
DOCKERHUB_TOKEN=<dockerhub-access-token>

# EC2 접속용 개인 키 전체 내용.
# -----BEGIN ...----- 부터 -----END ...----- 까지 줄바꿈 포함해서 넣는다.
EC2_SSH_KEY=<ec2-private-key>

# RDS DB 비밀번호.
DB_PASSWORD=<rds-password>

# JWT 서명 키. 최소 32바이트 이상 긴 랜덤 문자열을 쓴다.
# 생성 예시: openssl rand -base64 48
APP_JWT_SECRET=<openssl-rand-base64-48-result>
