# GitHub 저장소 Variables 템플릿
# 위치: GitHub Repository -> Settings -> Secrets and variables -> Actions -> Variables
# 민감하지 않은 배포 설정만 여기에 둔다. 비밀번호, 토큰, 개인 키, JWT 서명 키는 Secrets에 넣는다.

# 필수 변수

# Docker Hub 계정 이름. 이미지는 DOCKERHUB_USERNAME/sopkathon-server:<tag>로 푸시된다.
DOCKERHUB_USERNAME=<dockerhub-username>

# EC2 SSH 접속 정보. 호스트/사용자 자체는 민감값이 아니므로 Variables에 둔다.
EC2_HOST=<ec2-public-ip-or-domain>
# Amazon Linux는 보통 ec2-user, Ubuntu는 보통 ubuntu다.
EC2_USERNAME=ec2-user

# RDS 접속 정보 중 엔드포인트와 사용자 이름은 Variables로 관리한다.
# 외부 노출이 걱정되면 DB_URL/DB_USERNAME도 Secrets로 옮기고 워크플로를 맞춰 바꾼다.
DB_URL=jdbc:mysql://<rds-endpoint>:3306/sopkathon?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=<rds-username>

# 선택 변수
# 필요한 것만 GitHub에 만든다. 만들지 않으면 CD workflow의 기본값이 적용된다.

# 기본 배포 대상은 t4g 같은 ARM EC2다. t3/t2 같은 x86 EC2를 쓰면 linux/amd64로 바꾼다.
DOCKER_PLATFORM=linux/arm64

# SSH 포트를 바꾼 경우만 수정한다.
EC2_SSH_PORT=22

# EC2 외부 포트와 Spring Boot 컨테이너 내부 포트.
HOST_PORT=8080
SERVER_PORT=8080

# 작은 EC2에서 JVM이 메모리를 과하게 잡지 않게 제한한다.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

# update=보존, create=초기화, validate=검증.
# 서버 하나로 개발과 출품을 같이 하면 update를 기본으로 둔다.
DB_DDL_AUTO=update
# 테이블 생성 후 시드를 실행하려면 true.
DB_DEFER_DATASOURCE_INITIALIZATION=true
# always=시드 실행, never=끄기.
DB_SQL_INIT_MODE=never
# 시드 SQL 위치.
DB_SQL_INIT_DATA_LOCATIONS=optional:classpath:db/seed/local-test-account.sql

# 인증을 전체 허용하면 보호 API도 토큰 없이 열릴 수 있다. 원격 서버 기본은 false 권장.
APP_SECURITY_PERMIT_ALL=false

# 웹 클라이언트 Origin. 프론트가 로컬에서 원격 API를 붙이면 localhost도 같이 둔다.
# 여러 개면 쉼표로 구분한다. 프론트 배포 주소가 없으면 이 변수를 만들지 않아도 된다.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://<web-domain>
# 보통은 기본값 그대로 둔다. 프론트에서 특수 header/method가 필요할 때만 만든다.
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_EXPOSED_HEADERS=Authorization,Location
APP_CORS_ALLOW_CREDENTIALS=true

# Swagger Try it out이 호출할 배포 서버 주소. 비워두면 http://EC2_HOST:HOST_PORT로 만든다.
APP_SWAGGER_SERVER_URL=http://<ec2-public-ip-or-domain>:8080
APP_SWAGGER_SERVER_DESCRIPTION=Production
