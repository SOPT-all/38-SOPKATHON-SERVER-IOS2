# 수동 Docker Compose 배포 참고용 예시다.
# GitHub Actions에 넣을 값은 docs/operations/github-actions-variables.template.env 와
# docs/operations/github-actions-secrets.template.env 를 기준으로 하나씩 등록한다.
# CD workflow는 GitHub Variables/Secrets를 읽어서 EC2의 .env 파일을 자동 생성한다.

APP_IMAGE=<dockerhub-username>/sopkathon-server:latest # 수동 배포 때 EC2가 pull할 Docker image
SPRING_PROFILES_ACTIVE=prod # EC2/RDS 원격 서버 profile
HOST_PORT=8080 # EC2에서 외부에 열 포트
SERVER_PORT=8080 # 컨테이너 내부 Spring Boot 포트
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError" # 작은 EC2에서 JVM 메모리 사용량을 제한

DB_DDL_AUTO=update # update=보존, create=초기화, validate=검증
DB_DEFER_DATASOURCE_INITIALIZATION=true # 테이블 생성 후 seed 실행
DB_SQL_INIT_MODE=never # always=seed 실행, never=끄기
DB_SQL_INIT_DATA_LOCATIONS=optional:classpath:db/seed/local-test-account.sql # seed SQL 위치
DB_URL=jdbc:mysql://<rds-endpoint>:3306/sopkathon?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8 # RDS MySQL JDBC URL
DB_USERNAME=<rds-username> # RDS 계정
DB_PASSWORD=<rds-password> # RDS 비밀번호

APP_SECURITY_PERMIT_ALL=false # 원격 서버는 인증을 켜는 것을 기본값으로 권장
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://<web-domain> # 프론트 로컬/배포 origin
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS # 허용 HTTP method
APP_CORS_ALLOWED_HEADERS=* # 허용 요청 header
APP_CORS_EXPOSED_HEADERS=Authorization,Location # 브라우저 JS에서 읽을 응답 header
APP_CORS_ALLOW_CREDENTIALS=true # 인증 header/cookie 포함 요청 허용

APP_JWT_ISSUER=sopkathon # JWT 발급자 이름
APP_JWT_SECRET=<openssl-rand-base64-48-result> # 예: openssl rand -base64 48
APP_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=2880 # 해커톤 시연용 access token 만료 시간. 2880분=48시간, refresh token은 사용하지 않음

APP_SWAGGER_SERVER_URL=http://<ec2-public-ip-or-domain>:8080 # Swagger Try it out이 호출할 원격 API URL
APP_SWAGGER_SERVER_DESCRIPTION=Production # Swagger server 설명
